#:import dp kivy.metrics.dp
#:import Window kivy.core.window.Window
#:import NoTransition kivy.uix.screenmanager.NoTransition

<RoundButton@Button>:
    background_normal: ''
    background_down: ''
    background_color: (.18, .18, .18, 1)
    color: (.96, .96, .96, 1)
    font_size: dp(19)

<ChatRow>:
    size_hint_y: None
    height: body.height + dp(16)
    padding: dp(14), dp(8)
    spacing: dp(10)
    Widget:
        size_hint_x: 1 if root.role == 'user' else None
        width: 0
    BoxLayout:
        id: body
        orientation: 'vertical'
        size_hint_x: .82 if root.role == 'user' else 1
        size_hint_y: None
        height: message.texture_size[1] + dp(18)
        padding: dp(12), dp(9)
        canvas.before:
            Color:
                rgba: (.19, .19, .19, 1) if root.role == 'user' else (.33, .33, .33, .01)
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(17),]
        Label:
            id: message
            text: root.text
            markup: False
            color: (.97, .97, .97, 1)
            font_size: dp(16)
            size_hint_y: None
            text_size: self.width, None
            height: self.texture_size[1]
            halign: 'left'
            valign: 'middle'

<ChatDrawer@ModalView>:
    size_hint: None, 1
    size: dp(290), Window.height
    pos_hint: {'x': 0, 'center_y': .5}
    auto_dismiss: True
    background: ''
    background_color: (0, 0, 0, 0)
    BoxLayout:
        orientation: 'vertical'
        padding: dp(12)
        spacing: dp(8)
        canvas.before:
            Color:
                rgba: (.12, .12, .12, 1)
            Rectangle:
                pos: self.pos
                size: self.size
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            Label:
                text: 'VoiceCrew'
                font_size: dp(18)
                bold: True
                halign: 'left'
                valign: 'middle'
                text_size: self.size
            RoundButton:
                text: '＋'
                size_hint_x: None
                width: dp(46)
                on_release: app.new_chat(); root.dismiss()
        ScrollView:
            do_scroll_x: False
            GridLayout:
                id: chat_list
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(4)
        Widget:
            size_hint_y: None
            height: dp(1)
        RoundButton:
            text: '⚙  Settings'
            size_hint_y: None
            height: dp(46)
            halign: 'left'
            text_size: self.width - dp(20), self.height
            on_release: app.show_settings(); root.dismiss()

<ChatScreen@BoxLayout>:
    orientation: 'vertical'
    canvas.before:
        Color:
            rgba: (.13, .13, .13, 1)
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        size_hint_y: None
        height: dp(56)
        padding: dp(8), dp(6)
        spacing: dp(8)
        RoundButton:
            text: '☰'
            size_hint_x: None
            width: dp(44)
            on_release: app.open_sidebar()
        Label:
            text: app.current_title
            font_size: dp(17)
            bold: True
            color: (.97, .97, .97, 1)
            text_size: self.size
            halign: 'center'
            valign: 'middle'
        RoundButton:
            text: '＋'
            size_hint_x: None
            width: dp(44)
            on_release: app.new_chat()
    ScrollView:
        id: scroll
        do_scroll_x: False
        bar_width: 0
        effect_cls: 'ScrollEffect'
        GridLayout:
            id: messages
            cols: 1
            spacing: dp(2)
            padding: 0, dp(12)
            size_hint_y: None
            height: self.minimum_height
    BoxLayout:
        orientation: 'vertical'
        size_hint_y: None
        height: composer.height + dp(74)
        padding: dp(12), dp(4), dp(12), dp(8)
        Label:
            text: app.status
            size_hint_y: None
            height: dp(24)
            color: (.65, .65, .65, 1)
            font_size: dp(12)
            text_size: self.size
            halign: 'center'
            valign: 'middle'
        BoxLayout:
            size_hint_y: None
            height: composer.height + dp(12)
            padding: dp(6)
            spacing: dp(5)
            canvas.before:
                Color:
                    rgba: (.19, .19, .19, 1)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(23),]
            RoundButton:
                text: '◉'
                size_hint_x: None
                width: dp(43)
                background_color: (.19, .19, .19, 1)
                on_release: app.voice_input()
            TextInput:
                id: composer
                hint_text: 'Message…'
                multiline: True
                size_hint_y: None
                height: min(max(self.minimum_height, dp(42)), dp(88))
                background_color: (0,0,0,0)
                background_normal: ''
                background_active: ''
                foreground_color: (.97,.97,.97,1)
                hint_text_color: (.55,.55,.55,1)
                padding: dp(6), dp(10)
                font_size: dp(16)
                disabled: app.working
            RoundButton:
                text: '↑'
                size_hint_x: None
                width: dp(43)
                background_color: (.98, .98, .98, 1) if not app.working else (.35,.35,.35,1)
                color: (.06,.06,.06,1)
                disabled: app.working
                on_release: app.send()
    BoxLayout:
        size_hint_y: None
        height: dp(28)
        padding: dp(16), 0
        Label:
            text: 'VoiceCrew can make mistakes. Check important info.'
            color: (.48,.48,.48,1)
            font_size: dp(10)
            halign: 'center'
            text_size: self.size

<SettingsScreen@ScrollView>:
    do_scroll_x: False
    bar_width: dp(3)
    GridLayout:
        cols: 1
        size_hint_y: None
        height: self.minimum_height
        padding: dp(16), dp(12)
        spacing: dp(12)
        canvas.before:
            Color:
                rgba: (.13,.13,.13,1)
            Rectangle:
                pos: self.pos
                size: self.size
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            RoundButton:
                text: '‹'
                size_hint_x: None
                width: dp(46)
                on_release: app.show_chat()
            Label:
                text: 'Settings'
                font_size: dp(20)
                bold: True
                color: (.97,.97,.97,1)
                text_size: self.size
                halign: 'left'
                valign: 'middle'
        Label:
            text: 'Primary LLM'
            size_hint_y: None
            height: dp(28)
            font_size: dp(16)
            bold: True
            color: (.97,.97,.97,1)
            halign: 'left'
            text_size: self.size
        Label:
            text: 'এই একটিই আপনার মূল LLM। Provider, API key ও model name এখানে দিলে সব chat request সরাসরি এই provider-এ যাবে।'
            size_hint_y: None
            height: self.texture_size[1] + dp(8)
            text_size: self.width, None
            color: (.68,.68,.68,1)
            font_size: dp(13)
            halign: 'left'
        Spinner:
            id: provider
            text: 'OpenAI'
            values: ['OpenAI', 'DeepSeek', 'Google AI Studio']
            size_hint_y: None
            height: dp(48)
            background_normal: ''
            background_color: (.20,.20,.20,1)
            color: (.96,.96,.96,1)
            on_text: app.provider_changed()
        TextInput:
            id: model
            hint_text: 'Model name, e.g. gpt-4o-mini'
            multiline: False
            size_hint_y: None
            height: dp(50)
            background_normal: ''
            background_active: ''
            background_color: (.20,.20,.20,1)
            foreground_color: (.97,.97,.97,1)
            hint_text_color: (.56,.56,.56,1)
            padding: dp(12), dp(14)
        TextInput:
            id: api_key
            hint_text: 'API key (খালি রাখলে পুরোনো key থাকবে)'
            password: True
            multiline: False
            size_hint_y: None
            height: dp(50)
            background_normal: ''
            background_active: ''
            background_color: (.20,.20,.20,1)
            foreground_color: (.97,.97,.97,1)
            hint_text_color: (.56,.56,.56,1)
            padding: dp(12), dp(14)
        BoxLayout:
            size_hint_y: None
            height: dp(38)
            Label:
                id: key_hint
                text: ''
                color: (.63,.63,.63,1)
                font_size: dp(12)
                halign: 'left'
                text_size: self.size
                valign: 'middle'
            Button:
                text: 'Key মুছুন'
                size_hint_x: None
                width: dp(90)
                background_normal: ''
                background_color: (.38,.14,.14,1)
                on_release: app.clear_key()
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            Label:
                text: 'উত্তর voice-এ শোনান'
                color: (.95,.95,.95,1)
                font_size: dp(15)
                halign: 'left'
                text_size: self.size
                valign: 'middle'
            Switch:
                id: speak
                active: True
                size_hint_x: None
                width: dp(58)
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(8)
            RoundButton:
                text: '■  Voice থামান'
                on_release: app.stop_voice()
            RoundButton:
                text: 'Save settings'
                background_color: (.91,.91,.91,1)
                color: (.06,.06,.06,1)
                on_release: app.save_settings()
        Label:
            text: 'Knowledge agent'
            size_hint_y: None
            height: dp(38)
            font_size: dp(16)
            bold: True
            color: (.97,.97,.97,1)
            halign: 'left'
            text_size: self.size
            valign: 'bottom'
        Label:
            text: 'যোগ করা ফাইল থেকে প্রশ্নের সঙ্গে মেলে এমন ছোট অংশ knowledge parameter হিসেবে মূল LLM request-এ যাবে। পুরো ফাইল প্রতিবার পাঠানো হয় না, তাই 2GB RAM ফোনে হালকা থাকে।'
            size_hint_y: None
            height: self.texture_size[1] + dp(8)
            text_size: self.width, None
            color: (.68,.68,.68,1)
            font_size: dp(13)
            halign: 'left'
        RoundButton:
            text: '＋  PDF / TXT / DOCX / অন্যান্য ফাইল যোগ করুন'
            size_hint_y: None
            height: dp(48)
            on_release: app.choose_knowledge()
        GridLayout:
            id: knowledge_list
            cols: 1
            size_hint_y: None
            height: self.minimum_height
            spacing: dp(4)
        Widget:
            size_hint_y: None
            height: dp(14)

Root:
    orientation: 'vertical'
    ScreenManager:
        id: screens
        transition: NoTransition()
        Screen:
            name: 'chat'
            ChatScreen:
        Screen:
            name: 'settings'
            SettingsScreen:
