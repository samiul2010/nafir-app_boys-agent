name: Build VoiceCrew APK

on:
  workflow_dispatch:
  push:
    branches: [main, master]
  pull_request:
    branches: [main, master]

permissions:
  contents: read

jobs:
  build-apk:
    name: Native Buildozer Android debug APK
    runs-on: ubuntu-22.04
    timeout-minutes: 55

    steps:
      - name: Checkout source
        uses: actions/checkout@v4

      - name: Set up Python 3.11
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Restore Android build cache
        uses: actions/cache@v4
        with:
          path: |
            ~/.buildozer
            .buildozer
          key: buildozer-${{ runner.os }}-${{ hashFiles('buildozer.spec') }}
          restore-keys: |
            buildozer-${{ runner.os }}-

      - name: Install native build dependencies
        env:
          DEBIAN_FRONTEND: noninteractive
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends \
            autoconf automake build-essential ccache cmake git \
            libffi-dev libltdl-dev libncurses5-dev libncursesw5-dev \
            libssl-dev libtinfo6 libtool pkg-config unzip zip zlib1g-dev
          sudo rm -rf /var/lib/apt/lists/*

      - name: Install Buildozer
        run: |
          python -m pip install --upgrade pip setuptools wheel
          python -m pip install 'Cython==0.29.36' 'buildozer==1.5.0'
          buildozer --version

      - name: Build Android debug APK
        env:
          JAVA_HOME: ${{ env.JAVA_HOME_17_X64 }}
          ANDROID_ACCEPT_SDK_LICENSE: '1'
        run: buildozer android debug

      - name: Upload installable APK
        uses: actions/upload-artifact@v4
        with:
          name: VoiceCrew-debug-apk
          path: bin/*.apk
          if-no-files-found: error
          retention-days: 14
